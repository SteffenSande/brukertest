{%- import 'plattform.j2' as p -%}
{#- Konstantene til funksjonspakken, fra maler/pyspark/plattform.j2. Kontrakten malen får, brukes ikke. -#}
"""Konstantene for hele plattformen. GENERERT av ./generer fra maler/pyspark/plattform.j2. Ikke rediger her."""

# Standardkolonnene (columnTemplates i specly/Config/table_types.json).
LASTET = "{{ p.lastet }}"
KILDEFIL = "{{ p.kildefil }}"
UKJENTE = "{{ p.ukjente }}"
KILDESYSTEM = "{{ p.kildesystem }}"
FRA = "{{ p.fra }}"
TIL = "{{ p.til }}"
PK = "pk__{tabell}"
BK = "bk__{tabell}"

# Gyldighetskolonnene i en SCD2-dimensjon i gull.
DIM_FRA = "{{ p.dim_fra }}"
DIM_TIL = "{{ p.dim_til }}"

# Åpen slutt på en versjon, og gyldig fra på spesialradene i en SCD2-dimensjon (SQL-literaler, brukes med F.expr).
APEN_SLUTT = "{{ p.apen_slutt }}"
UKJENT_FRA = "{{ p.ukjent_fra }}"

# Tidspunktet i filnavnet …_ÅÅÅÅMMDDThhmm.<filtype>, som SQL-uttrykk over _metadata.
FILTIDSPUNKT = '''{{ p.filtidspunkt }}'''

# De to spesialradene i hver gull-dimensjon: ukjent (nøkkelverdi uten treff) og mangler (tom nøkkel).
UKJENT_NOKKEL = {{ p.ukjent_nokkel }}
UKJENT_TEKST = "{{ p.ukjent_tekst }}"
MANGLER_NOKKEL = {{ p.mangler_nokkel }}
MANGLER_TEKST = "{{ p.mangler_tekst }}"

# tom_til_null: disse verdiene blir NULL.
TOMME_VERDIER = [{% for v in p.tomme_verdier %}"{{ v }}"{{ ', ' if not loop.last }}{% endfor %}]

# Hashformelen.
TOM_NOKKELDEL = "{{ p.tom_nokkeldel }}"
NOKKEL_TIDSFORMAT = "{{ p.nokkel_tidsformat }}"
IKKE_FUNNET = "{{ p.ikke_funnet }}"

# Datodimensjonen: pk__ er datoen som tallet ÅÅÅÅMMDD.
DATONOKKEL_FORMAT = "{{ p.datonokkel_format }}"
