{%- import 'felles_py.j2' as f -%}
{%- import 'plattform.j2' as p -%}
{%- from 'modell.j2' import modell -%}
{#- Gull dimensjon: fra sølv + spesialradene (-1 Ukjent, -2 Mangler). Historikk fra feltet Historikk.
    Kolonner fra en annen sølvtabell hentes via hovedtabellens fb__-kolonne mot den tabellens bk__.
    Datodimensjonen (én BK-kolonne av typen date) får pk__ som tallet ÅÅÅÅMMDD i stedet for en hash. -#}
{%- set dc = data_contract -%}
{%- set t = modell.tabeller[dc.schema_[0].name] -%}
{%- set bk = t.kolonner|selectattr('bk')|list -%}
{%- set hoved = bk[0].opp[0].rsplit('.', 1)[0] -%}
{%- set data = t.kolonner|rejectattr('navn', 'in', t.standard)|list -%}
{%- set andre = [] -%}
{%- for c in data %}{% for o in c.opp %}{% set tb = o.rsplit('.', 1)[0] %}{% if tb != hoved and tb not in andre|map(attribute='tabell')|list %}
{%- for hk in modell.tabeller[hoved].kolonner %}{% if (tb ~ '.bk__' ~ tb) in hk.rel %}{% set _ = andre.append({'tabell': tb, 'fb': hk.navn}) %}{% endif %}{% endfor %}
{%- endif %}{% endfor %}{% endfor -%}
{%- set datonokkel = bk|length == 1 and (bk[0].type or '')|lower == 'date' and t.historikk != 'SCD2' -%}
{{ f.topp(dc, t) }}
from pyspark import pipelines as dp

from plattform.felles import Kolonne, ddl, egenskaper, kopi
from plattform.gull import {{ 'Oppslag, ' if andre }}lag_dimensjon, med_spesialrader

{{ f.kolonner(dc) }}


{{ f.dekorator(dc, 'materialized_view') }}
def {{ t.navn }}():
    """Dimensjon fra {{ hoved }}{{ (' med oppslag i ' ~ andre|map(attribute='tabell')|join(', ')) if andre }}, historikk {{ t.historikk }}{{ ', pk__ = datoen som ÅÅÅÅMMDD' if datonokkel }}, med ukjent-rad (-1) og mangler-rad (-2)."""
    dimensjon = lag_dimensjon(
        hovedtabell={{ f.s(hoved) }},
        historikk={{ f.s(t.historikk) }},
{%- if andre %}
        oppslag=[
{%- for a in andre %}
            Oppslag({{ f.s(a.tabell) }}, via={{ f.s(a.fb) }}{% set n = modell.tabeller[a.tabell].kolonner|selectattr('bk')|list|length %}{% if n != 1 %}, nokkeldeler={{ n }}{% endif %}),
{%- endfor %}
        ],
{%- endif %}
        kolonner={
{%- for c in data if c.opp %}
            {{ f.s(c.navn) }}: kopi({{ f.s(c.opp[0]) }}),
{%- endfor %}
{%- if p.kildesystem in t.standard %}
            {{ f.s(p.kildesystem) }}: kopi({{ f.s(hoved ~ '.' ~ p.kildesystem) }}),
{%- endif %}
        },
        nokkel={{ f.liste(bk|map(attribute='navn')|list) }},
        tabell={{ f.s(t.navn) }},
{%- if datonokkel %}
        datonokkel_pa=True,
{%- endif %}
    )
    return med_spesialrader(dimensjon, KOLONNER, tabell={{ f.s(t.navn) }})
